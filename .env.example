# GEMINI_API_KEY: Required for Google Gemini & Nano Banana (2.1 / 2 / Pro) AI calls.
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI GPT Image 2.5 and GPT Image 2 models.
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# DASHSCOPE_API_KEY: Required for Alibaba Cloud Qwen Image 3 Pro (DashScope Model Studio).
# Get it from: https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY="MY_DASHSCOPE_API_KEY"

# OPENROUTER_API_KEY: Optional unified API key fallback for Qwen / multi-provider routing.
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

