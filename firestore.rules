rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'credits', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'credits', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.credits is int && data.credits >= 0 && data.credits <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['ownerId', 'name', 'mode', 'currentVersionId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'mode', 'currentVersionId', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.mode is string && (data.mode == 'single' || data.mode == 'batch')
        && data.currentVersionId is string && data.currentVersionId.size() >= 1 && data.currentVersionId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVersion(data, projectId) {
      return data.keys().hasAll(['projectId', 'ownerId', 'imageUrl', 'parentId', 'promptUsed', 'modelUsed', 'createdAt'])
        && data.keys().hasOnly(['projectId', 'ownerId', 'imageUrl', 'parentId', 'promptUsed', 'modelUsed', 'createdAt'])
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.projectId == projectId
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500000
        && data.parentId is string && data.parentId.size() >= 1 && data.parentId.size() <= 128
        && data.promptUsed is string && data.promptUsed.size() <= 4000
        && data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'status', 'type', 'cost', 'model', 'prompt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'status', 'type', 'cost', 'model', 'prompt', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.status is string && (data.status == 'queued' || data.status == 'processing' || data.status == 'completed' || data.status == 'failed')
        && data.type is string && (data.type == 'detect' || data.type == 'edit' || data.type == 'magic_erase' || data.type == 'upscale' || data.type == 'editable')
        && data.cost is int && data.cost >= 0 && data.cost <= 100
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
        && data.prompt is string && data.prompt.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCreditTransaction(data) {
      return data.keys().hasAll(['ownerId', 'amount', 'type', 'reason', 'jobId', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'amount', 'type', 'reason', 'jobId', 'createdAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.amount is int && data.amount >= -1000 && data.amount <= 100000
        && data.type is string && (data.type == 'deduct' || data.type == 'refund' || data.type == 'purchase' || data.type == 'bonus')
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300
        && data.jobId is string && data.jobId.size() >= 1 && data.jobId.size() <= 128
        && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidUser(incoming())
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'displayName', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn()
        && isValidProject(incoming())
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['currentVersionId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mode', 'currentVersionId', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;

      match /versions/{versionId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(versionId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(projectId)
          && isValidId(versionId)
          && isValidVersion(incoming(), projectId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /jobs/{jobId} {
      allow get: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(jobId)
        && isValidJob(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidJob(incoming())
        && isValidId(jobId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().type == existing().type
        && incoming().cost == existing().cost
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'completed'
        && existing().status != 'failed'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /credit_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(txId)
        && isValidCreditTransaction(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if false;
    }
  }
}
